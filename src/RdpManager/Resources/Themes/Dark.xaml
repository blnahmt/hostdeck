<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        KOYU TEMA - koyu gri agirlikli (siyah degil), ince kirmizi vurgu.
        Anahtarlar Light.xaml ile birebir ayni.
    -->

    <!-- Yuzeyler -->
    <SolidColorBrush x:Key="Brush.Background"    Color="#1E1E20" />
    <SolidColorBrush x:Key="Brush.Surface"       Color="#252528" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#2C2C30" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="#191919" />

    <!-- Cizgiler -->
    <SolidColorBrush x:Key="Brush.Border"       Color="#333338" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#45454C" />

    <!-- Metin -->
    <SolidColorBrush x:Key="Brush.Text"          Color="#EDEDEF" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A0A0A8" />
    <SolidColorBrush x:Key="Brush.TextMuted"     Color="#71717A" />
    <SolidColorBrush x:Key="Brush.TextOnAccent"  Color="#FFFFFF" />

    <!-- Kirmizi vurgu: koyu zeminde biraz daha acik ton okunakli kaliyor -->
    <SolidColorBrush x:Key="Brush.Accent"        Color="#E05C5C" />
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#EA6E6E" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#C94A4A" />
    <SolidColorBrush x:Key="Brush.AccentSubtle"  Color="#332326" />

    <!-- Etkilesim -->
    <SolidColorBrush x:Key="Brush.Hover"    Color="#2E2E33" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#332326" />
    <!-- Liste satirinda secim: kirmizi kenarlik yerine belirgin zemin -->
    <SolidColorBrush x:Key="Brush.SelectedStrong" Color="#3E3E45" />

    <!-- Durum -->
    <SolidColorBrush x:Key="Brush.Success" Color="#4FB06B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#D9AE45" />
    <SolidColorBrush x:Key="Brush.Danger"  Color="#E05C5C" />

    <SolidColorBrush x:Key="Brush.SessionBackdrop" Color="#141416" />

</ResourceDictionary>
