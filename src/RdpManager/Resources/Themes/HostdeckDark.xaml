<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        HOSTDECK KOYU - gercek siyah zemin, beyaz metin, yumusak kirmizi vurgu.
        Anahtarlar Light.xaml ile BIREBIR ayni olmali.
    -->

    <SolidColorBrush x:Key="Brush.Background"    Color="#000000" />
    <SolidColorBrush x:Key="Brush.Surface"       Color="#0A0A0A" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#141414" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="#050505" />

    <SolidColorBrush x:Key="Brush.Border"       Color="#232323" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#353535" />

    <SolidColorBrush x:Key="Brush.Text"          Color="#F5F5F5" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A3A3A3" />
    <SolidColorBrush x:Key="Brush.TextMuted"     Color="#6B6B6B" />
    <SolidColorBrush x:Key="Brush.TextOnAccent"  Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Accent"        Color="#EC6B69" />
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#F27F7D" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#D85A58" />
    <SolidColorBrush x:Key="Brush.AccentSubtle"  Color="#2A1616" />

    <SolidColorBrush x:Key="Brush.Hover"    Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#2A1616" />
    <SolidColorBrush x:Key="Brush.SelectedStrong" Color="#262626" />

    <SolidColorBrush x:Key="Brush.Success" Color="#4FB06B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#D9AE45" />
    <SolidColorBrush x:Key="Brush.Danger"  Color="#E05C5C" />

    <SolidColorBrush x:Key="Brush.SessionBackdrop" Color="#000000" />

</ResourceDictionary>
