<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        HOSTDECK ACIK - saf beyaz zemin, siyah metin, yumusak kirmizi vurgu.
        Anahtarlar Light.xaml ile BIREBIR ayni olmali.
    -->

    <SolidColorBrush x:Key="Brush.Background"    Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface"       Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="#F5F5F5" />

    <SolidColorBrush x:Key="Brush.Border"       Color="#E6E6E6" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#CFCFCF" />

    <SolidColorBrush x:Key="Brush.Text"          Color="#0A0A0A" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5C5C5C" />
    <SolidColorBrush x:Key="Brush.TextMuted"     Color="#959595" />
    <SolidColorBrush x:Key="Brush.TextOnAccent"  Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Accent"        Color="#E35D5B" />
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#D24F4D" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#BB4341" />
    <SolidColorBrush x:Key="Brush.AccentSubtle"  Color="#FDEEEE" />

    <SolidColorBrush x:Key="Brush.Hover"    Color="#F2F2F2" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#FDEEEE" />
    <SolidColorBrush x:Key="Brush.SelectedStrong" Color="#E8E8E8" />

    <SolidColorBrush x:Key="Brush.Success" Color="#3F9D5B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#C99A2E" />
    <SolidColorBrush x:Key="Brush.Danger"  Color="#D64545" />

    <SolidColorBrush x:Key="Brush.SessionBackdrop" Color="#111111" />

</ResourceDictionary>
