<Window x:Class="RdpManager.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RdpManager.Views"
        xmlns:models="clr-namespace:RdpManager.Models"
        xmlns:loc="clr-namespace:RdpManager.Localization"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="Transparent"
        SizeToContent="Height"
        Width="580"
        Title="{loc:T 'Hizli baglan'}">
    <Border Background="{DynamicResource Brush.SurfaceRaised}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Arama -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0"
                      Data="{StaticResource Icon.Search}"
                      Style="{StaticResource MenuIcon}"
                      Width="15" Height="15"
                      Margin="4,0,10,0" />

                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox"
                             FontSize="{StaticResource Font.Size.Large}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0,6"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock Text="{loc:T 'Sunucu ara, Enter ile baglan  ·  &gt; komutlar'}"
                               Style="{StaticResource Text.Muted}"
                               FontSize="{StaticResource Font.Size.Large}"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
                </Grid>
            </Grid>

            <Border Grid.Row="1" Height="1" Margin="0,10"
                    Background="{DynamicResource Brush.Border}" />

            <ListBox x:Name="ResultList"
                     Grid.Row="2"
                     MaxHeight="360"
                     MouseDoubleClick="ResultList_MouseDoubleClick"
                     PreviewKeyDown="ResultList_PreviewKeyDown">
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type views:PaletteCommand}">
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Hint}" Style="{StaticResource Text.Muted}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type models:RdpConnection}">
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="3" Margin="0,0,10,0"
                                    Background="{Binding Color, TargetNullValue=Transparent}" />

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <views:EmojiText Text="{Binding Icon}" EmojiSize="15"
                                                     Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Address}" Style="{StaticResource Text.Muted}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TagsDisplay}"
                                           Style="{StaticResource Text.Muted}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                            Visibility="{Binding HasRemoteUser, Converter={StaticResource BoolToVisible}}">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Accent}" Margin="0,0,5,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RemoteUser}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>
        </Grid>
    </Border>
</Window>
