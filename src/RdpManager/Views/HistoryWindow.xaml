<views:ChromeWindow x:Class="RdpManager.Views.HistoryWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:RdpManager.Views"
                    xmlns:loc="clr-namespace:RdpManager.Localization"
                    Title="{loc:T 'Baglanti gecmisi'}"
                    Height="560" Width="640"
                    MinHeight="320" MinWidth="460"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sutun basliklari: satir sablonuyla ayni genislikler -->
        <Grid Grid.Row="0" Margin="24,16,24,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:T 'TARIH'}" Style="{StaticResource Text.SectionHeader}" />
            <TextBlock Grid.Column="1" Text="{loc:T 'SUNUCU'}" Style="{StaticResource Text.SectionHeader}" />
            <TextBlock Grid.Column="2" Text="{loc:T 'SURE'}" Style="{StaticResource Text.SectionHeader}" />
        </Grid>

        <ListBox x:Name="HistoryList" Grid.Row="1" Margin="12,0"
                 MouseDoubleClick="HistoryList_MouseDoubleClick"
                 KeyDown="HistoryList_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding StartedText}" Style="{StaticResource Text.Secondary}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Address}" Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Text.Secondary}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="{loc:T 'Henuz bir baglanti kaydi yok.'}"
                   Style="{StaticResource Text.Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid>
                <TextBlock Text="{loc:T 'Cift tikla veya Enter: yeniden baglan'}"
                           Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T 'Gecmisi temizle'}" Style="{StaticResource Button.Ghost}"
                            Click="Clear_Click" Margin="0,0,10,0" />
                    <Button Content="{loc:T 'Kapat'}" Style="{StaticResource Button.Primary}"
                            Click="Close_Click" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:ChromeWindow>
