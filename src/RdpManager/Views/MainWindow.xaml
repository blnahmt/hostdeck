<views:ChromeWindow x:Class="RdpManager.Views.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:RdpManager.Views"
                    xmlns:vm="clr-namespace:RdpManager.ViewModels"
                    xmlns:app="clr-namespace:RdpManager"
                    xmlns:loc="clr-namespace:RdpManager.Localization"
                    Title="{x:Static app:AppEdition.Name}"
                    Height="800" Width="560"
                    MinHeight="440" MinWidth="420"
                    WindowStartupLocation="CenterScreen">

    <views:ChromeWindow.Resources>

        <!-- Erisilebilirlik noktasi: yesil = port acik, kirmizi = kapali, gizli = henuz yoklanmadi -->
        <Style x:Key="ReachDot" TargetType="Rectangle">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReachable}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                    <Setter Property="ToolTip" Value="{loc:T 'Sunucu erisilebilir'}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReachable}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="ToolTip" Value="{loc:T 'Sunucuya erisilemiyor'}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Etiket cipi (liste ve kart gorunumunde ortak) -->
        <DataTemplate x:Key="TagChip">
            <Border Background="{DynamicResource Brush.SurfaceSunken}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="7,1"
                    Margin="0,0,5,4">
                <TextBlock Text="{Binding}"
                           FontSize="10.5"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </Border>
        </DataTemplate>

        <!-- ============ Satir gorunumu ============ -->
        <DataTemplate x:Key="ConnectionRow">
            <!-- Satir yogunlugu ListBox.Tag'den geliyor (kompakt / rahat) -->
            <Grid Margin="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="3" Margin="0,0,10,0"
                        Background="{Binding Color, TargetNullValue=Transparent}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <views:EmojiText Text="{Binding Icon}" EmojiSize="15"
                                         Margin="0,0,7,0" VerticalAlignment="Center" />
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.Success}"
                                 ToolTip="{loc:T 'Bu sunucunun acik bir oturumu var'}"
                                 Visibility="{Binding IsSessionOpen, Converter={StaticResource BoolToVisible}}" />
                        <TextBlock Text="{Binding DisplayName}" />
                        <views:EmojiText Text="⭐" EmojiSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                         ToolTip="{loc:T 'Sabitlenmis'}"
                                         Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>

                    <!-- IP ve etiketler ayni satirda -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Rectangle Style="{StaticResource ReachDot}" />
                        <TextBlock Text="{Binding Address}" Style="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center" />

                        <ItemsControl ItemsSource="{Binding Tags}"
                                      ItemTemplate="{StaticResource TagChip}"
                                      Margin="8,0,0,0" VerticalAlignment="Center">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTags}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Uzak kullanici (API'den) — belirgin rozet -->
                <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                        Background="{DynamicResource Brush.AccentSubtle}"
                        BorderBrush="{DynamicResource Brush.Accent}"
                        BorderThickness="1" Padding="9,3"
                        Visibility="{Binding HasRemoteUser, Converter={StaticResource BoolToVisible}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Accent}" Margin="0,0,6,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RemoteUser}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Son oturum ekran goruntusu (kucuk resim) -->
                <Border Grid.Column="3" VerticalAlignment="Center" Margin="10,0,2,0"
                        Width="64" Height="40"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        ToolTip="{loc:T 'Son oturum goruntusu'}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisible}">
                            <Binding Path="HasThumbnail" />
                            <Binding Path="DataContext.ShowThumbnails"
                                     RelativeSource="{RelativeSource AncestorType=ListBox}" />
                        </MultiBinding>
                    </Border.Visibility>
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,64,40" />
                    </Border.Clip>
                    <Image Stretch="UniformToFill">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource Thumbnail}">
                                <Binding Path="ThumbnailPath" />
                                <Binding Path="ThumbnailVersion" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ============ Kart (grid) gorunumu ============ -->
        <DataTemplate x:Key="ConnectionCard">
            <Border x:Name="Card"
                    Width="146"
                    Margin="5"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <!-- Arka planda son oturum goruntusu (varsa, soluk) -->
                    <Image Stretch="UniformToFill" Opacity="0.14">
                        <Image.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueToVisible}">
                                <Binding Path="HasThumbnail" />
                                <Binding Path="DataContext.ShowThumbnails"
                                         RelativeSource="{RelativeSource AncestorType=ListBox}" />
                            </MultiBinding>
                        </Image.Visibility>
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource Thumbnail}">
                                <Binding Path="ThumbnailPath" />
                                <Binding Path="ThumbnailVersion" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>

                <StackPanel Margin="11,9">
                    <!-- Ust renk seridi -->
                    <Border Height="3" Margin="0,0,0,8"
                            Background="{Binding Color, TargetNullValue=Transparent}" />

                    <StackPanel Orientation="Horizontal">
                        <views:EmojiText Text="{Binding Icon}" EmojiSize="15"
                                         Margin="0,0,6,0" VerticalAlignment="Center" />
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.Success}"
                                 ToolTip="{loc:T 'Bu sunucunun acik bir oturumu var'}"
                                 Visibility="{Binding IsSessionOpen, Converter={StaticResource BoolToVisible}}" />
                        <TextBlock Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DisplayName}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Rectangle Style="{StaticResource ReachDot}" />
                        <TextBlock Text="{Binding Address}" Style="{StaticResource Text.Muted}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Uzak kullanici (API'den) -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                Visibility="{Binding HasRemoteUser, Converter={StaticResource BoolToVisible}}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Accent}" Margin="0,0,5,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RemoteUser}" FontSize="13.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Tags}"
                                  ItemTemplate="{StaticResource TagChip}"
                                  Margin="0,7,0,0">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTags}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Value="True"
                             Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Selected}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="GridPanel">
            <WrapPanel Orientation="Horizontal" Margin="10,4,0,0" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="RowPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>

        <!--
            Kart gorunumunde secim gorseli kartin kendi cercevesinde;
            kapsayicinin sol vurgu cizgisi ve zemini devre disi.
        -->
        <Style x:Key="CardContainer" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </views:ChromeWindow.Resources>

    <views:ChromeWindow.TitleBarActions>
        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
            <Button Style="{StaticResource Button.IconOnly}"
                    Tag="{StaticResource Icon.Settings}"
                    Width="30" Height="26"
                    ToolTip="{loc:T 'Ayarlar'}"
                    Click="Settings_Click" />
        </StackPanel>
    </views:ChromeWindow.TitleBarActions>

    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tek satir arac cubugu: solda arama, sagda islemler + siralama -->
        <Grid Grid.Row="0" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Arama -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Padding="10,5"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                         ToolTip="{loc:T 'Ad, adres veya etikete gore ara. Tek sonucta Enter ile baglanir.'}" />
                <TextBlock Text="{loc:T 'Ara...'}"
                           Style="{StaticResource Text.Muted}"
                           Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisible}}" />
            </Grid>

            <!-- Islemler (sagda, ince ikonlar) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.IconOnly}" Tag="{StaticResource Icon.Plus}"
                        Width="30" Height="30" Margin="0,0,2,0" ToolTip="{loc:T 'Yeni baglanti'}" Click="New_Click" />
                <Button Style="{StaticResource Button.IconOnly}" Tag="{StaticResource Icon.Edit}"
                        Width="30" Height="30" Margin="0,0,2,0" ToolTip="{loc:T 'Duzenle'}" Click="Edit_Click" />
                <Button Style="{StaticResource Button.IconOnly}" Tag="{StaticResource Icon.Copy}"
                        Width="30" Height="30" Margin="0,0,2,0" ToolTip="{loc:T 'Cogalt'}" Click="Duplicate_Click" />
                <Button Style="{StaticResource Button.IconOnly}" Tag="{StaticResource Icon.Trash}"
                        Width="30" Height="30" Margin="0,0,8,0" ToolTip="{loc:T 'Sil'}" Click="Delete_Click" />

                <Border Width="1" Height="18" Margin="0,0,8,0"
                        Background="{DynamicResource Brush.Border}" VerticalAlignment="Center" />

                <Button Style="{StaticResource Button.IconOnly}" Tag="{StaticResource Icon.Import}"
                        Width="30" Height="30" Margin="0,0,2,0" ToolTip="{loc:T 'Ice aktar (.rdp veya .json)'}" Click="Import_Click" />
                <Button Style="{StaticResource Button.IconOnly}" Tag="{StaticResource Icon.Export}"
                        Width="30" Height="30" Margin="0,0,2,0" ToolTip="{loc:T 'Disa aktar (JSON)'}" Click="Export_Click" />
                <Button Style="{StaticResource Button.IconOnly}" Tag="{StaticResource Icon.History}"
                        Width="30" Height="30" Margin="0,0,8,0" ToolTip="{loc:T 'Baglanti gecmisi'}" Click="History_Click" />

                <Border Width="1" Height="18" Margin="0,0,8,0"
                        Background="{DynamicResource Brush.Border}" VerticalAlignment="Center" />

                <Button x:Name="SortButton" Style="{StaticResource Button.IconOnly}" Tag="{StaticResource Icon.Sort}"
                        Width="30" Height="30" ToolTip="{loc:T 'Sirala'}" Click="Sort_Click">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom" Opened="SortMenu_Opened">
                            <MenuItem Header="{loc:T 'Kendi siram (surukleyerek)'}" Click="SortMode_Click" Tag="Manual" />
                            <MenuItem Header="{loc:T 'Ada gore'}"          Click="SortMode_Click" Tag="Name" />
                            <MenuItem Header="{loc:T 'Adrese gore'}"       Click="SortMode_Click" Tag="Address" />
                            <MenuItem Header="{loc:T 'Son kullanima gore'}" Click="SortMode_Click" Tag="LastUsed" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Etiket cipleri: tiklayarak filtrele (birden fazla secilirse "herhangi biri") -->
        <Grid Grid.Row="1" Margin="18,0,18,10">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasTags}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="TagChip_Click" Tag="{Binding Name}" Cursor="Hand" Margin="0,0,6,6">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chip"
                                            Background="{DynamicResource Brush.SurfaceSunken}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            Padding="11,4">
                                        <TextBlock x:Name="Label"
                                                   Text="{Binding Name}"
                                                   FontSize="{StaticResource Font.Size.Small}"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Selected}" />
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Liste -->
        <Grid Grid.Row="2">
            <!--
                SelectedItem BILEREK baglanmiyor: WPF'te SelectedItem'a deger
                atamak diger secimleri temizliyor, iki yonlu binding geri
                yazdiginda coklu secim tek ogeye cokuyordu. Secim kod tarafinda
                SelectionChanged ile ViewModel'e aktariliyor.
            -->
            <ListBox x:Name="ConnectionList"
                     ItemsSource="{Binding ConnectionsView}"
                     SelectionMode="Extended"
                     AllowDrop="True"
                     MouseDoubleClick="ConnectionList_MouseDoubleClick"
                     KeyDown="ConnectionList_KeyDown"
                     SelectionChanged="ConnectionList_SelectionChanged"
                     PreviewMouseLeftButtonDown="ConnectionList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="ConnectionList_PreviewMouseMove"
                     DragOver="ConnectionList_DragOver"
                     Drop="ConnectionList_Drop"
                     PreviewMouseRightButtonDown="ConnectionList_PreviewMouseRightButtonDown">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="ConnectMenuItem" Header="{loc:T 'Baglan'}" Click="ContextConnect_Click">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Connect}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="FavoriteMenuItem" Header="{loc:T 'Sabitle'}" Click="Favorite_Click" />
                        <Separator />
                        <MenuItem x:Name="EditMenuItem" Header="{loc:T 'Duzenle'}" Click="Edit_Click">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Edit}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="DuplicateMenuItem" Header="{loc:T 'Cogalt'}" Click="Duplicate_Click">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Copy}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="DeleteMenuItem" Header="{loc:T 'Sil'}" Click="Delete_Click">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Trash}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <StackPanel x:Name="EmptyHint"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <views:EmojiText Text="🖥️" EmojiSize="64" HorizontalAlignment="Center" Opacity="0.85" />
                <TextBlock Text="{loc:T 'Henuz baglanti yok'}"
                           FontSize="{StaticResource Font.Size.Large}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextAlignment="Center" HorizontalAlignment="Center"
                           Margin="0,14,0,4" />
                <TextBlock Text="{loc:T 'Baslamak icin ilk sunucunu ekle.'}"
                           Style="{StaticResource Text.Muted}"
                           TextAlignment="Center" HorizontalAlignment="Center"
                           Margin="0,0,0,16" />
                <Button Style="{StaticResource Button.Primary}" Click="New_Click"
                        HorizontalAlignment="Center" Padding="16,7">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource ButtonIcon}" />
                        <TextBlock Text="{loc:T 'Yeni baglanti'}" Foreground="{DynamicResource Brush.TextOnAccent}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Durum -->
        <Border Grid.Row="3"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="18,7">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Secondary}" />
        </Border>
    </Grid>
</views:ChromeWindow>
