<views:ChromeWindow x:Class="RdpManager.Views.PassphraseDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:RdpManager.Views"
                    xmlns:loc="clr-namespace:RdpManager.Localization"
                    Title="{loc:T 'Parola'}"
                    Width="520"
                    SizeToContent="Height"
                    ResizeMode="NoResize"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,4">
            <TextBlock x:Name="ExplanationText"
                       Style="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <TextBlock Text="{loc:T 'Parola'}" Style="{StaticResource Text.Muted}" Margin="0,0,0,5" />
            <PasswordBox x:Name="PassphraseInput" PasswordChanged="Input_Changed" />

            <StackPanel x:Name="ConfirmSection" Margin="0,12,0,0">
                <TextBlock Text="{loc:T 'Parola (tekrar)'}" Style="{StaticResource Text.Muted}" Margin="0,0,0,5" />
                <PasswordBox x:Name="ConfirmInput" PasswordChanged="Input_Changed" />
            </StackPanel>

            <TextBlock x:Name="HintText"
                       Style="{StaticResource Text.Muted}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,14"
                Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:T 'Iptal'}" Style="{StaticResource Button.Ghost}" Click="Cancel_Click" Margin="0,0,10,0" />
                <Button x:Name="OkButton" Content="{loc:T 'Tamam'}" Style="{StaticResource Button.Primary}"
                        Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</views:ChromeWindow>
