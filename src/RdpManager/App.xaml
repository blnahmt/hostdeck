<Application x:Class="RdpManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RdpManager.ViewModels"
             xmlns:views="clr-namespace:RdpManager.Views"
             xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
             xmlns:loc="clr-namespace:RdpManager.Localization">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Tema sozlugu (Light/Dark) calisma aninda ThemeService tarafindan
                    BUNUN YERINE gecirilir. Buradaki sadece tasarim zamani onizlemesi.
                -->
                <ResourceDictionary Source="Resources/Themes/Light.xaml" />
                <ResourceDictionary Source="Resources/Icons.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <!-- ChromeWindow stili Themes/Generic.xaml'de; DefaultStyleKey oradan cozuyor. -->
            </ResourceDictionary.MergedDictionaries>

            <views:EmptyToVisibleConverter x:Key="EmptyToVisible" />
            <views:BoolToVisibleConverter x:Key="BoolToVisible" />
            <views:ContrastForegroundConverter x:Key="ContrastForeground" />
            <views:TabTitleForegroundConverter x:Key="TabTitleForeground" />
            <views:ThumbnailConverter x:Key="Thumbnail" />
            <views:AllTrueToVisibleConverter x:Key="AllTrueToVisible" />

            <!-- Sekme sablonlari tum oturum pencerelerinde ortak -->
            <DataTemplate x:Key="SessionTabHeader" DataType="{x:Type vm:SessionTabItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sunucu simgesi -->
                    <views:EmojiText Grid.Column="0" Text="{Binding Connection.Icon}"
                                     EmojiSize="14"
                                     Margin="0,0,7,0" VerticalAlignment="Center" />

                    <!--
                        Renk/kalinlik DragablzItem'dan aliniyor. Daha once araya giren
                        ContentPresenter'dan aliniyordu; onun Foreground'u varsayilan
                        siyah oldugu icin sekme yazisi koyu temada gorunmuyordu.
                    -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               ToolTip="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type dragablz:DragablzItem}}}" />
                                <Setter Property="FontWeight"
                                        Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type dragablz:DragablzItem}}}" />
                                <Style.Triggers>
                                    <!-- Arka planda kopan oturum: baslik vurgulanir -->
                                    <DataTrigger Binding="{Binding HasUnseenAlert}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Kapat butonu yalniz aktif sekmede veya uzerine gelince gorunur -->
                    <Button Grid.Column="2"
                            Tag="{StaticResource Icon.Close}"
                            Width="20" Height="20"
                            Margin="0"
                            ToolTip="{loc:T 'Sekmeyi kapat'}"
                            Command="{Binding CloseCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.IconOnly}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type dragablz:DragablzItem}}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type dragablz:DragablzItem}}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Sag tik menusu artik konteyner (DragablzItem) seviyesinde;
                         Styles.xaml > SessionTabItemStyle icinde tanimli. -->
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SessionTabContent" DataType="{x:Type vm:SessionTabItem}">
                <ContentControl Content="{Binding DisplayedHost}" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
